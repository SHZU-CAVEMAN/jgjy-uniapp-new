		{ "path": "pages/my-comments/index", "style": { "navigationBarTitleText": "我的留言" } },
		{ "path": "pages/my-consults/index", "style": { "navigationBarTitleText": "我的咨询" } },
		{ "path": "pages/news/index", "style": { "navigationBarTitleText": "企业动态", "enablePullDownRefresh": true } },
		{ "path": "pages/article-detail/index", "style": { "navigationBarTitleText": "文章详情" } },
		{ "path": "pages/video-player/index", "style": { "navigationBarTitleText": "视频播放", "navigationBarTextStyle": "white", "navigationBarBackgroundColor": "#000000", "backgroundColor": "#000000" } },
		{ "path": "pages/product-detail/index", "style": { "navigationBarTitleText": "产品详情" } },
		{ "path": "pages/storage-detail/index", "style": { "navigationBarTitleText": "储酒详情" } },
		{ "path": "pages/business/storage/index", "style": { "navigationBarTitleText": "原酒收储" } },
		{ "path": "pages/business/technology/index", "style": { "navigationBarTitleText": "技术服务" } },
		{ "path": "pages/business/finance/index", "style": { "navigationBarTitleText": "白酒金融" } },
		{ "path": "pages/trace-report/index", "style": { "navigationBarTitleText": "溯源报告" } },
		{ "path": "pages/consult/index", "style": { "navigationBarTitleText": "发起咨询" } },
		{ "path": "pages/about/index", "style": { "navigationBarTitleText": "关于我们" } }
